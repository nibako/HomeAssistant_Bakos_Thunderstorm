def load_options() -> dict[str, Any]:
    with OPTIONS_PATH.open("r", encoding="utf-8") as handle:
        return json.load(handle)


def clamp(value: float, low: float, high: float) -> float:
    return max(low, min(high, value))


@dataclass
class MixBlock:
    filename: str
    path: Path
    duration: float
    timeline: list[dict[str, Any]]
    last_thunder: str | None
    rain_offset_seconds: float


class DynamicMixer:
    """Build a fresh one-stream rain+thunder MP3 for each storm session/block."""

    def __init__(self, source_dir: Path, media_dir: Path) -> None:
        self.source_dir = source_dir
        self.media_dir = media_dir
        self.lock = threading.Lock()
        self.ready = False
        self.pcm_paths: dict[str, Path] = {}
        self.frame_counts: dict[str, int] = {}

    def prepare(self) -> bool:
        self.media_dir.mkdir(parents=True, exist_ok=True)
        PCM_DIR.mkdir(parents=True, exist_ok=True)
        missing = [name for name in sorted(SOURCE_AUDIO_FILES) if not (self.source_dir / name).is_file()]
        if missing:
            logging.error("Bundled Bako's Thunderstorm audio is incomplete: %s", missing)
            return False
        if not shutil.which("ffmpeg"):
            logging.error("ffmpeg is not installed")
            return False
        if not shutil.which("lame"):
            logging.error("lame is not installed")
            return False
        try:
            for name in SOURCE_AUDIO_FILES:
                source = self.source_dir / name
                # Keep the bundled source audio available to the browser audio fallback.
                target = self.media_dir / name
                if (not target.is_file()) or target.stat().st_size != source.stat().st_size:
                    shutil.copyfile(source, target)
                raw = PCM_DIR / f"{name}.s16le"
                stamp = PCM_DIR / f"{name}.meta.json"
                needs_decode = True
                if raw.is_file() and stamp.is_file():
                    try:
                        meta = json.loads(stamp.read_text(encoding="utf-8"))
                        needs_decode = not (
                            int(meta.get("source_size", -1)) == source.stat().st_size
                            and int(meta.get("sample_rate", 0)) == SAMPLE_RATE
